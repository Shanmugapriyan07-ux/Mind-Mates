// app.config.js
// Use this instead of app.json so you can read environment variables at build time.

export default {
  expo: {
    name: "MyApp",
    slug: "myapp",

    // ── CRITICAL: Must match EXPO_PUBLIC_APP_SCHEME and your Google redirect URI ──
    scheme: "myapp",

    version: "1.0.0",
    orientation: "portrait",
    userInterfaceStyle: "light",

    android: {
      package: "com.yourcompany.myapp",   // ← Change to your package name
      adaptiveIcon: {
        foregroundImage: "./assets/adaptive-icon.png",
        backgroundColor: "#FFFFFF",
      },
    },

    ios: {
      bundleIdentifier: "com.yourcompany.myapp",  // ← Change to your bundle ID
      supportsTablet: false,
    },

    plugins: [
      // expo-auth-session requires this plugin to handle deep links on Android
      [
        "expo-build-properties",
        {
          android: {
            usesCleartextTraffic: false,
          },
        },
      ],
    ],

    // Deep link configuration — required for OAuth redirect
    intentFilters: [
      {
        action: "VIEW",
        autoVerify: true,
        data: [
          {
            scheme: "myapp",      // Must match `scheme` above
            host: "auth",
            pathPrefix: "/callback",
          },
        ],
        category: ["BROWSABLE", "DEFAULT"],
      },
    ],
  },
};


// cat > /mnt/user-data/outputs/badge_schema.sql << 'SQL' -- ══════════════════════════════════════════════════════════════ -- Badge count schema — run in Supabase SQL Editor -- ══════════════════════════════════════════════════════════════  -- 1. Add push_token column to users (if not already there) ALTER TABLE public.users ADD COLUMN IF NOT EXISTS push_token TEXT; CREATE INDEX IF NOT EXISTS idx_users_push_token ON public.users(push_token)   WHERE push_token IS NOT NULL;  -- 2. Unread counts view — single query gives total badge count --    Used by: badgeService, push function, client sync CREATE OR REPLACE VIEW public.user_unread_counts AS SELECT   u.user_id,    -- Unread notifications: is_read = false   COUNT(DISTINCT n.id) FILTER (WHERE n.is_read = false) AS notif_unread,    -- Unread chats: last message was from someone else AND status != 'seen'   -- and the chat is not hidden for this user   COUNT(DISTINCT c.id) FILTER (     WHERE c.last_sender_id   != u.user_id       AND c.last_message_status  != 'seen'       AND c.last_message IS NOT NULL       AND c.last_message != ''       AND NOT (u.user_id::text = ANY(COALESCE(c.hidden_for, '{}')))   ) AS chat_unread,    -- Total badge count   (     COUNT(DISTINCT n.id) FILTER (WHERE n.is_read = false) +     COUNT(DISTINCT c.id) FILTER (       WHERE c.last_sender_id   != u.user_id         AND c.last_message_status != 'seen'         AND c.last_message IS NOT NULL         AND c.last_message != ''         AND NOT (u.user_id::text = ANY(COALESCE(c.hidden_for, '{}')))     )   ) AS total_unread  FROM public.users u LEFT JOIN public.notifications n   ON n.user_id = u.user_id LEFT JOIN public.chats c   ON u.user_id::text = ANY(c.participants) GROUP BY u.user_id;  -- 3. RLS: users can only see their own counts ALTER VIEW public.user_unread_counts OWNER TO postgres;  -- Grant access GRANT SELECT ON public.user_unread_counts TO authenticated;  -- 4. Helper function: get badge count for one user CREATE OR REPLACE FUNCTION get_badge_count(p_user_id TEXT) RETURNS INTEGER LANGUAGE sql STABLE SECURITY DEFINER AS $$   SELECT COALESCE(total_unread::integer, 0)   FROM   public.user_unread_counts   WHERE  user_id = p_user_id   LIMIT  1; $$; GRANT EXECUTE ON FUNCTION get_badge_count TO authenticated, service_role;  -- 5. Enable realtime on notifications (already done for chats) ALTER PUBLICATION supabase_realtime ADD TABLE public.notifications;  -- Verify SELECT * FROM public.user_unread_counts LIMIT 3; SQL echo "✅ badge_schema.sql"

