    "reset-project": "cd Mind-Mates && npx rimraf node_modules package-lock.json .expo && npm install",
    "doctor": "cd Mind-Mates && npx expo-doctor",
    "start": "cd Mind-Mates && npx expo start --port 3000",
    "web": "cd Mind-Mates && npx expo start --web --port 3000"
