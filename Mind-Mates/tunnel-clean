const { height } = Dimensions.get('window');

const Loginscreen = () => {
  
  const { refetch, loading: globalLoading, isLogged } = useGlobalContext();
 
  // State
  const [isLogin, setIsLogin] = useState(true);
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    password: '',
    confirmPassword: '',
  });

  const [showPassword, setShowPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);
  const [loading, setLoading] = useState(false);
  const [googleLoading, setGoogleLoading] = useState(false);
const [errors, setErrors] = useState({
  email: '',
  password: '',
  confirmPassword: '',
  
});


  // const [facebookLoading, setFacebookLoading] = useState(false);

  // Animation values
  const fadeAnim = useRef(new Animated.Value(0)).current;
  const slideAnim = useRef(new Animated.Value(2)).current;
  const scaleAnim = useRef(new Animated.Value(0.2)).current;
  const logoScale = useRef(new Animated.Value(0.1)).current;
  const toggleAnim = useRef(new Animated.Value(isLogin ? 0 : 1)).current;
  
  // Input animations
  const nameOpacity = useRef(new Animated.Value(0)).current;
  const nameHeight = useRef(new Animated.Value(0)).current;
  const confirmOpacity = useRef(new Animated.Value(0)).current;
  const confirmHeight = useRef(new Animated.Value(0)).current;

  // Floating animation
  const float1 = useRef(new Animated.Value(0)).current;
  const float2 = useRef(new Animated.Value(0)).current;
  const float3 = useRef(new Animated.Value(0)).current;

  // const { refetch } = useGlobalContext();


   useEffect(() => {
    // Entrance animations
    Animated.parallel([
      Animated.timing(fadeAnim, {
         toValue: 1,
        // duration: 1000,
        useNativeDriver: true,
      }),
      Animated.spring(slideAnim, {
        toValue: 0,
        // tension: 20,
        // friction: 7,
        useNativeDriver: true,
      }),
      Animated.spring(scaleAnim, {
        toValue: 1,
        // tension: 20,
        // friction: 7,
        useNativeDriver: true,
      }),
      Animated.spring(logoScale, {
        toValue: 1,
        // tension: 15,
        // friction: 5,
        useNativeDriver: true,
      }),
    ]).start();

    // Floating animations
    Animated.loop(
      Animated.sequence([
        Animated.timing(float1, {
          toValue: 1,
          duration: 3000,
          useNativeDriver: true,
        }),
        Animated.timing(float1, {
          toValue: 0,
          duration: 3000,
          useNativeDriver: true,
        }),
      ])
    ).start();

    Animated.loop(
      Animated.sequence([
        Animated.timing(float2, {
          toValue: 1,
          // duration: 4000,
          useNativeDriver: true,
        }),
        Animated.timing(float2, {
          toValue: 0,
          // duration: 4000,
          useNativeDriver: true,
        }),
      ])
    ).start();

    Animated.loop(
      Animated.sequence([
        Animated.timing(float3, {
          toValue: 1,
          // duration: 3500,
          useNativeDriver: true,
        }),
        Animated.timing(float3, {
          toValue: 0,
          // duration: 3500,
          useNativeDriver: true,
        }),
      ])
    ).start();
  }, []);

  useEffect(() => {
    // Animate toggle and form fields
    Animated.parallel([
      Animated.spring(toggleAnim, {
        toValue: isLogin ? 0 : 1,
        
        useNativeDriver: false,
      }),
      Animated.parallel([
        Animated.timing(nameOpacity, {
           toValue: isLogin ? 0 : 1,
          // duration: 300,
          useNativeDriver: false,
        }),
        Animated.timing(nameHeight, {
          toValue: isLogin ? 0 : 90,
          // duration: 300,
          useNativeDriver: false,
        }),
        Animated.timing(confirmOpacity, {
          toValue: isLogin ? 0 : 1,
          // duration: 300,
          useNativeDriver: false,
        }),
        Animated.timing(confirmHeight, {
          toValue: isLogin ? 0 : 90,
          // duration: 300,
          useNativeDriver: false,
        }),
      ]),
    ]).start();
  }, [isLogin]);

  const handleChange = (name: string, value: string) => {
    setFormData({
      ...formData,
      [name]: value,
    });
  };


  useEffect(() => {
    if (!globalLoading && isLogged) {
      router.replace("/Screens/Matchscreen");
    }
          }, [isLogged, globalLoading]);

    const validation = () => {
      const email = formData.email.trim().toLowerCase();
      const password = formData.password.trim();
      if (!email || !password) {
        Alert.alert('Error', 'Please fill all fields');
        return false;
      }
      if (!email.includes('@')) {
        errors.email = "Please enter a valid email address";
        setErrors(errors);
        return false;
      }
      if (password.length < 8) {
        errors.password = "Password must be at least 8 characters";
        setErrors(errors);
        return false;
      }
      if(showConfirmPassword && password !== formData.confirmPassword.trim()) {
        errors.confirmPassword = "Passwords do not match";
        setErrors(errors);
        return false;
      }
      return true;
    };

  const handleSubmit = async () => {
    // Basic validation first (saves network time)
    const email = formData.email.trim().toLowerCase();
    const password = formData.password.trim();
    if (!email || !password || (!isLogin && !formData.name)) {
      Alert.alert('Error', 'Please fill all fields');
      return;
    }

    if (!validation()) {
      return;
    }

    setLoading(true);
    try {
      // STEP 1 & 2: Auth with Appwrite
      if (isLogin) {
        await account.createEmailPasswordSession(email, password);
      } else {
        await account.create(ID.unique(), email, password, formData.name.trim());
        await account.createEmailPasswordSession(email, password);
      }

      // STEP 3: Parallelize data fetching (FETCHING JWT AND USER DATA AT THE SAME TIME)
      // This saves roughly 200-500ms
      const [jwtObj, user] = await Promise.all([
        account.createJWT(),
        account.get()
      ]);

      // STEP 4: Fire-and-forget or background sync with Spring Boot
      // We don't want to make the user wait for the Spring Boot DB sync if Appwrite is done
      syncWithBackend(jwtObj.jwt, user);

      // STEP 5: Immediate UI Update
      await refetch();
      router.replace('/Screens/Matchscreen');

    } catch (error: any) {
      console.error('Auth Error:', error);
      Alert.alert('Login Failed', error.message || 'Check your credentials');
    } finally {
      setLoading(false);
    }
  };

  // Move this logic outside to keep the main function clean and fast
  const syncWithBackend = async (jwt: string, user: any) => {
    try {
      await fetch('http://10.0.2.2:8080/api/auth/sync', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${jwt}`,
        },
        body: JSON.stringify({
          appwriteId: user.$id,
          name: user.name,
          email: user.email,
          action: isLogin ? 'LOGIN' : 'SIGNUP',
        }),
      });
    } catch (e) {
      console.warn("Background sync failed, but user is logged in to Appwrite.");
    }
  };

 

  const handleGoogleSignIn = async () => {
  if (googleLoading) return;

  setGoogleLoading(true);
  try {
    // STEP 1: Appwrite OAuth2 Login
    // This triggers the browser popup. Once the user picks an account, 
    // Appwrite creates the session automatically.
    const session = await login(); 

    if (session) {
      console.log("✅ Google Session created");

      // STEP 2: Parallelize JWT and User Data retrieval
      // We do this instead of waiting for one then the other.
      const [jwtObj, user] = await Promise.all([
        account.createJWT(),
        account.get()
      ]);

      // STEP 3: Background Sync with Spring Boot
      // Don't 'await' this if you want the UI to move instantly.
      // This sends the Appwrite data to your Java backend.
      syncWithBackendd(jwtObj.jwt, user);

      // STEP 4: Update Global State and Navigate
      await refetch();
      router.replace('/Screens/Matchscreen');
      
      Alert.alert("Success", `Welcome ${user.name}!`);
    }
  } catch (error: any) {
    console.error("Google Login Error:", error);
    let errorMessage = error.message || "An unknown error occurred";
    
    // Handle the common "user cancelled" error gracefully
    if (errorMessage.includes("dismissed") || errorMessage.includes("cancel")) {
      return; // User just closed the popup, no need for an alert
    }
    
    Alert.alert("Login Failed", errorMessage);
  } finally {
    setGoogleLoading(false);
  }
  }

// Reusable sync function
const syncWithBackendd = async (jwt: string, user: any) => {
  try {
    await fetch("http://10.0.2.2:8080/api/auth/google-sync", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${jwt}` 
      },
      body: JSON.stringify({
        appwriteId: user.$id,
        email: user.email,
        name: user.name,
        provider: 'google'
      })
    });
  } catch (e) {
    console.warn("Spring Boot sync failed, but user is authenticated in Appwrite.");
  }
};
     
  

  
  const float1Translate = float1.interpolate({
    inputRange: [0, 1],
    outputRange: [0, -15],
  }); 
  
  const float2Translate = float2.interpolate({
    inputRange: [0, 1],
    outputRange: [0, 20],
  });
  
  const float3Translate = float3.interpolate({
    inputRange: [0, 1],
    outputRange: [0, -10],
  });
  
  return (
    <View style={styles.container}>
      <StatusBar barStyle="light-content" />
      
      {/* Gradient Background */}
      <LinearGradient
        colors={['#3B82F6', '#8B5CF6', '#EC4899']}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
        style={styles.background}
        />

      {/* Floating Circles */}
      <Animated.View
        style={[
          styles.floatingCircle,
          styles.circle1,
          { transform: [{ translateY: float1Translate }] },
        ]}
        />
      <Animated.View
        style={[
          styles.floatingCircle,
          styles.circle2,
          { transform: [{ translateY: float2Translate }] },
        ]}
        />
      <Animated.View
        style={[
          styles.floatingCircle,
          styles.circle3,
          { transform: [{ translateY: float3Translate }] },
        ]}
        />

      <KeyboardAvoidingView
        style={styles.keyboardView}
        behavior={Platform.OS === 'ios' ? 'padding' : undefined}
        >
        <ScrollView
          contentContainerStyle={styles.scrollContent}
          keyboardShouldPersistTaps="handled"
          showsVerticalScrollIndicator={false}
          >
          {/* Logo */}
          <Animated.View
            style={[
              styles.logoContainer,
              {
                opacity: fadeAnim,
                transform: [{ scale: logoScale }, { translateY: slideAnim }],
              },
            ]}
            >
            <LinearGradient
              colors={['#FFFFFF', '#F0F0F0']}
              style={styles.logoCircle}
              >
              <Text style={styles.logoText}>M</Text>
            </LinearGradient>
            <Text style={styles.brandName}>MindMates</Text>
            <Text style={styles.brandSubtitle}>Welcome back!</Text>
          </Animated.View>

          {/* Auth Card */}
          <Animated.View
            style={[
              styles.cardContainer,
              {
                opacity: fadeAnim,
                transform: [{ scale: scaleAnim }],
              },
            ]}
          >
            <BlurView intensity={20} tint="light" style={styles.card}>
              {/* Toggle Buttons */}
              <View style={styles.toggleContainer}>
                <Animated.View
                  style={[
                    styles.toggleSlider,
                    {
                      left: toggleAnim.interpolate({
                        inputRange: [0, 1],
                        outputRange: ['2%', '50%'],
                       }
                      ),
                  },
                  ]
                }
                  />
                <TouchableOpacity
                  style={styles.toggleButton}
                  onPress={() => setIsLogin(true)}
                  activeOpacity={0.8}
                  >
                  <Text
                    style={[
                      styles.toggleText,
                      isLogin && styles.toggleTextActive,
                    ]}
                    >
                    Login
                  </Text>
                </TouchableOpacity>
                <TouchableOpacity
                  style={styles.toggleButton}
                  onPress={() => setIsLogin(false)}
                  activeOpacity={0.8}
                  >
                  <Text
                    style={[
                      styles.toggleText,
                      !isLogin && styles.toggleTextActive,
                    ]}
                  >
                    Sign Up
                  </Text>
                </TouchableOpacity>
              </View>

              {/* Form */}
              <View style={styles.form}>
                {/* Name Field (Sign Up only) */}
                <Animated.View
                  style={{
                    opacity: nameOpacity,
                    height: nameHeight,
                    overflow: 'hidden',
                  }}
                  >
                  <Text style={styles.label}>Full Name</Text>
                  <View style={styles.inputContainer}>
                    <Text style={styles.inputIcon}>👤</Text>
                    <TextInput
                      style={styles.input}
                      placeholder="John Doe"
                      placeholderTextColor="rgba(255, 255, 255, 0.6)"
                      value={formData.name}
                      onChangeText={(value) => handleChange('name', value)}
                      autoCapitalize="words"
                      />
                  </View>
                </Animated.View>

                {/* Email */}
                <View style={styles.inputWrapper}>
                  <Text style={styles.label}>Email Address</Text>
                  <Text style={styles.errorText}>{errors.email}</Text>
                  <View style={styles.inputContainer}>
                    <Text style={styles.inputIcon}>📧</Text>
                    <TextInput
                      style={styles.input}
                      placeholder="Enter your email"
                      placeholderTextColor="rgba(255, 255, 255, 0.6)"
                      value={formData.email}
                      onChangeText={(value) => handleChange('email', value)}
                      keyboardType="email-address"
                      autoCapitalize="none"
                      autoCorrect={false}
                      />
                  </View>
                </View>

                {/* Password */}
                <View style={styles.inputWrapper}>
                  <Text style={styles.label}>Password</Text>
                  <View style={styles.inputContainer}>
                    <Text style={styles.inputIcon}>🔒</Text>
                    <TextInput
                      style={styles.input}
                      placeholder="••••••••"
                      placeholderTextColor="rgba(255, 255, 255, 0.6)"
                      value={formData.password}
                      onChangeText={(value) => handleChange('password', value)}
                      secureTextEntry={!showPassword}
                      autoCapitalize="none"
                      />
                    <TouchableOpacity
                      style={styles.eyeButton}
                      onPress={() => setShowPassword(!showPassword)}
                      >
                      <Text style={styles.eyeIcon}>
                        {showPassword ? '👁️' : '🙈'}
                      </Text>
                    </TouchableOpacity>
                  </View>
                </View>

                {/* Confirm Password (Sign Up only) */}
                <Animated.View
                  style={{
                    opacity: confirmOpacity,
                    height: confirmHeight,
                    overflow: 'hidden',
                  }}
                  >
                  <Text style={styles.label}>Confirm Password</Text>
                  <View style={styles.inputContainer}>
                    <Text style={styles.inputIcon}>✅</Text>
                    <TextInput
                      style={styles.input}
                      placeholder="••••••••"
                      placeholderTextColor="rgba(255, 255, 255, 0.6)"
                      value={formData.confirmPassword}
                      onChangeText={(value) =>
                        handleChange('confirmPassword', value)
                      }
                      secureTextEntry={!showConfirmPassword}
                      autoCapitalize="none"
                      />
                    <TouchableOpacity
                      style={styles.eyeButton}
                      onPress={() =>
                        setShowConfirmPassword(!showConfirmPassword)
                      }
                      >
                      <Text style={styles.eyeIcon}>
                        {showConfirmPassword ? '👁️' : '🙈'}
                      </Text>
                    </TouchableOpacity>
                  </View>
                </Animated.View>

                {/* Forgot Password (Login only) */}
                {isLogin && (
                  <TouchableOpacity
                  style={styles.forgotPassword}
                    onPress={() =>
                      Alert.alert('Forgot Password', 'Feature coming soon!')
                    }
                    >
                    <Text style={styles.forgotPasswordText}>
                      Forgot Password?
                    </Text>
                  </TouchableOpacity>
                )}

                {/* Submit Button */}
                <TouchableOpacity
                  style={[styles.submitButton, loading && styles.buttonDisabled]}
                  
                  disabled={loading}
                  activeOpacity={0.8}
      onPress={handleSubmit}
                >
                  <LinearGradient
                    colors={['#3B82F6', '#2563EB']}
                    start={{ x: 0, y: 0 }}
                    end={{ x: 1, y: 0 }}
                    style={styles.submitGradient}
                  >
                    {loading ? (
                      <ActivityIndicator color="#FFFFFF" />
                    ) : (
                      <Text style={styles.submitText}>
                        {isLogin ? 'Login' : 'Create Account'}
                      </Text>
                    )}
                  </LinearGradient>
                </TouchableOpacity>
              </View>

              {/* Divider */}
              <View style={styles.dividerContainer}>
                <View style={styles.divider} />
                <Text style={styles.dividerText}>Or continue with</Text>
                <View style={styles.divider} />
              </View>

              {/* Social Buttons */}
              <View style={styles.socialContainer}>
                <TouchableOpacity
                  style={styles.socialButton}
                  onPress={handleGoogleSignIn}
                  disabled={googleLoading}
                  activeOpacity={0.8}
                  >
                  {googleLoading ? (
                    <ActivityIndicator color="#3B82F6" size="small" />
                  ) : (
                    <>
                      <View style={styles.googleIcon}>
                        <Image source={icons.google} style={{ width: 16, height: 16 }} />
                      </View>
                      <Text style={styles.socialText}>Google</Text>
                    </>
                  )}
                </TouchableOpacity>
              </View>
            </BlurView>
          </Animated.View>

          {/* Terms (Sign Up only) */}
          {!isLogin && (
            <Animated.View
              // style={[styles.termsContainer, { opacity: fadeAnim }]}
            >
              <Text style={styles.termsText}>
                By signing up, you agree to our{' '}
                <Text style={styles.termsLink}>Terms of Service</Text> and{' '}
                <Text style={styles.termsLink}>Privacy Policy</Text>
              </Text>
            </Animated.View>
          )}
        </ScrollView>
      </KeyboardAvoidingView>
    </View>
  );
};


